# ===== Alvoprompt — variáveis de ambiente (opcionais) =====
# Copie para .env.local e preencha apenas o que for usar.
# Sem estas variáveis o app funciona 100% local/offline.

# --- Inteligência artificial (opcional) ---
# Chave usada em geração de roteiro, análise, títulos e tradução de legendas.
VITE_DEEPSEEK_API_KEY=

# --- Firebase (opcional: sincronização em nuvem) ---
# Crie um projeto no Console do Firebase (plano Spark, gratuito):
#   1. Adicionar app "Web" e copiar a config abaixo.
#   2. Authentication → Sign-in method → ativar "E-mail/senha".
#   3. Firestore Database → criar banco em modo de teste (produção: regras autenticadas).
#   O app grava/lista roteiros em uma coleção "scripts" com doc id = id local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudflare (opcional: transcrição Whisper e TTS/dublagem) ---
# Veja README: /functions/cloudflare e o Worker em api/transcribe
# A API base padrão já aponta para http://localhost:8787 no modo dev.
VITE_CLOUDFLARE_API_BASE=
