# ===== AlvoPrompter — variáveis de ambiente (opcionais) =====
# Copie para .env.local e preencha apenas o que for usar.
# Sem estas variáveis o app funciona 100% local/offline.

# --- Cloudflare (IA, transcrição Whisper, TTS/dublagem e sync) ---
# Veja README: /functions/cloudflare e o Worker em api/transcribe
# A API base padrão já aponta para http://localhost:8787 no modo dev.
# O sync de roteiros usa o mesmo Worker (endpoint /sync, KV + frase-chave).
VITE_CLOUDFLARE_API_BASE=

# --- Firebase Authentication (valores públicos do app Web) ---
# Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# A chave da DeepSeek nunca deve usar o prefixo VITE_. Configure-a somente no Worker:
# cd api/transcribe && npx wrangler secret put DEEPSEEK_API_KEY

# --- Segredos do Worker para contas e cobrança ---
# Nunca use prefixo VITE_ nestas variáveis:
# cd api/transcribe
# npx wrangler secret put ASAAS_API_KEY
# npx wrangler secret put ASAAS_WEBHOOK_TOKEN
# O FIREBASE_PROJECT_ID, APP_URL e ASAAS_API_BASE ficam em api/transcribe/wrangler.toml.
