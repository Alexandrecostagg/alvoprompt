# ===== Alvoprompt — variáveis de ambiente (opcionais) =====
# Copie para .env.local e preencha apenas o que for usar.
# Sem estas variáveis o app funciona 100% local/offline.

# --- Inteligência artificial (opcional) ---
# Chave usada em geração de roteiro, análise, títulos e tradução de legendas.
VITE_DEEPSEEK_API_KEY=

# --- Cloudflare (opcional: transcrição Whisper, TTS/dublagem e sync) ---
# Veja README: /functions/cloudflare e o Worker em api/transcribe
# A API base padrão já aponta para http://localhost:8787 no modo dev.
# O sync de roteiros usa o mesmo Worker (endpoint /sync, KV + frase-chave).
VITE_CLOUDFLARE_API_BASE=
