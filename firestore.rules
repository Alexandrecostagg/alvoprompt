rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Roteiros sincronizados. Modo de teste: qualquer usuário autenticado
    // pode ler/escrever. Antes de produção, restringir por dono (uid).
    match /scripts/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
